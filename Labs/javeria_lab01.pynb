(\"1. Estimate fare: 30,000\")\n","    print(\"   Departure Time: 6PM\")\n","    print(\"   Arrival Time: 9PM\")\n","    print(\"2. Estimate fare: 20,000\")\n","    print(\"   Departure Time: 10PM\")\n","    print(\"   Arrival Time: 3AM\")\n","  elif budget <= 40000:\n","    print(\"There are three flights available for you.\")\n","    print(\"1. Estimate fare: 36,000\")\n","    print(\"   Departure Time: 4PM\")\n","    print(\"   Arrival Time: 6PM\")\n","\n","    print(\"2. Estimate fare: 28,000\")\n","    print(\"   Departure Time: 6PM\")\n","    print(\"   Arrival Time: 9PM\")\n","\n","    print(\"3. Estimate fare: 20,000\")\n","    print(\"   Departure Time: 10PM\")\n","    print(\"   Arrival Time: 3AM\")\n","\n","elif departure_city == \"Karachi\" and destination_city == \"Islamabad\":\n","  print(\"I've found two available flights for you. \")\n","  print(\"Can you tell me your budget?\")\n","  budget = int(input(\"Enter Your Budget in Rupees:\"))\n","  if budget < 20000:\n","    print(\"Sorry, with your budget there is no flight available.\")\n","  elif budget >= 20000 and budget <=30000:\n","    print(\"There's a flight available for you.\")\n","    print(\"Estimate fare: 25,000\")\n","    print(\"Departure Time: 7PM\")\n","    print(\"Arrival Time: 12AM\")\n","\n","  elif budget > 30000:\n","    print(\"There are two flights available for you.\")\n","    print(\"1. Estimate fare: 34,000\")\n","    print(\"   Departure Time: 5PM\")\n","    print(\"   Arrival Time: 6:30PM\")\n","    print(\"2. Estimate fare: 25,000\")\n","    print(\"   Departure Time: 7PM\")\n","    print(\"   Arrival Time: 12AM\")\n","\n","elif departure_city == \"Karachi\" and destination_city == \"Multan\":\n","  print(\"I've found one available flights for you. \")\n","  print(\"Can you tell me your budget?\")\n","  budget = int(input(\"Enter Your Budget in Rupees:\"))\n","  if budget < 15000:\n","    print(\"Sorry, with your budget there is no flight available.\")\n","  elif budget >= 15000 and budget <=20000:\n","    print(\"There's a flight available for you.\")\n","    print(\"Estimate fare: 19,000\")\n","    print(\"Departure Time: 5:30PM\")\n","    print(\"Arrival Time: 8:30PM\")\n","else:\n","    print(\"Sorry, there are no available flights from\", departure_city,\"to\", destination_city, \"!\")\n","\n"]}]}